DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
API_PORT=4000
WEB_PORT=3000
DEMO_TARGET_PORT=4174
# mock (labelled demo script), deepseek, or gateway
SENTINEL_LLM_PROVIDER=gateway
SENTINEL_LLM_MODEL=deepseek/deepseek-v4-flash-0731
AI_GATEWAY_API_KEY=
DEEPSEEK_API_KEY=
SENTINEL_API_BASE_URL=http://127.0.0.1:4000
# Set to true only for local demo targets such as TaskForge.
SENTINEL_ALLOW_LOCALHOST=false
